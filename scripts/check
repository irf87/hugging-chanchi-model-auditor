#!/usr/bin/env bash
# The gate: every check that must hold before a merge. Run by git hooks and CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR, GIT_INDEX_FILE and friends to hooks. Tests that create their own
# repositories would inherit them and write into this one, so clear them first.
unset $(git rev-parse --local-env-vars)

if [ "${CI:-}" != "true" ]; then
  if [ "$(git config --get core.hooksPath || true)" != ".githooks" ]; then
    echo "warning: git hooks are off. Run: git config core.hooksPath .githooks" >&2
  fi
  if [ "$(git config --get merge.ff || true)" != "false" ]; then
    echo "warning: fast-forward merges skip the pre-merge-commit gate. Run: git config merge.ff false" >&2
  fi
fi

uv run --group dev ruff check
uv run --group dev pytest -q
